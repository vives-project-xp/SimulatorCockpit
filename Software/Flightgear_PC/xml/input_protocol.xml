<?xml version="1.0"?>
<PropertyList>

  <generic>
    <input>
      <binary_mode>false</binary_mode>
      <line_separator>newline</line_separator>
      <var_separator>:</var_separator>

      <chunk>
        <name>Battery</name>
        <node>/controls/switches/master-bat</node>
        <type>integer</type>
      </chunk>

      <chunk>
        <name>Alt</name>
        <node>/controls/switches/master-alt</node>
        <type>integer</type>
      </chunk>

      <chunk>
        <name>CarbHeat</name>
        <node>/controls/engines/current-engine/carb-heat</node>
        <type>integer</type>
      </chunk>

      <chunk>
        <name>PrimerLever</name>
        <node>/controls/engines/engine/primer-lever</node>
        <type>integer</type>
      </chunk>

      <chunk>
        <name>Primer</name>
        <node>/controls/engines/engine/primer</node>
        <type>integer</type>
      </chunk>

      <chunk>
        <name>Magnetos</name>
        <node>/controls/switches/magnetos</node>
        <type>integer</type>
      </chunk>

      <chunk>
        <name>Starter</name>
        <node>/controls/switches/starter</node>
        <type>bool</type>
      </chunk>

      <chunk>
        <name>FuelMixture</name>
        <node>/controls/engines/current-engine/mixture</node>
        <type>float</type>
      </chunk>

    </input>
  </generic>

</PropertyList>
