<?xml version="1.0"?>
<PropertyList>

  <generic>
    <input>
      <binary_mode>false</binary_mode>
      <line_separator>newline</line_separator>
      <var_separator>:</var_separator>

      <!-- 1ste waarde -->
      <chunk>
        <name>Battery</name>
        <node>/controls/switches/master-bat</node>
        <type>integer</type>
      </chunk>

      <!-- 2de waarde -->
      <chunk>
        <name>Throttle</name>
        <node>/controls/engines/engine[0]/throttle</node>
        <type>float</type>
      </chunk>

      <!-- 3de waarde -->
      <chunk>
        <name>AltimeterSetting</name>
        <node>/instrumentation/altimeter/setting-inhg</node>
        <type>float</type>
      </chunk>

    </input>
  </generic>

</PropertyList>
