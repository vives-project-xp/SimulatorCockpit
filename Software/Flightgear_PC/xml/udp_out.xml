<?xml version="1.0"?>
<PropertyList>
  <generic>
    <output>
      <line_separator>newline</line_separator>
      <var_separator>newline</var_separator>

      <chunk>
        <name>Airspeed</name>
        <node>/instrumentation/airspeed-indicator/indicated-speed-kt</node>
        <type>float</type>
        <format>AIRSPEED=%f</format>
      </chunk>

      <chunk>
        <name>Heading</name>
        <node>/orientation/heading-deg</node>
        <type>float</type>
        <format>HEADING=%f</format>
      </chunk>

      <chunk>
        <name>AltimeterAltitude</name>
        <node>/instrumentation/altimeter/indicated-altitude-ft</node>
        <type>float</type>
        <format>ALTITUDE=%f</format>
      </chunk>

      <chunk>
        <name>AltimeterSetting</name>
        <node>/instrumentation/altimeter/setting-inhg</node>
        <type>float</type>
        <format>ALT_SETTING=%f</format>
      </chunk>

      <chunk>
        <name>VerticalSpeed</name>
        <node>/instrumentation/vertical-speed-indicator/indicated-speed-fpm</node>
        <type>float</type>
        <format>VSI=%f</format>
      </chunk>

    </output>
  </generic>
</PropertyList>
